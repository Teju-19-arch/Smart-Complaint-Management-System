# Copy to backend/.env and fill in real values. NEVER commit .env
PORT=5000

# Local MongoDB, or your MongoDB Atlas connection string in production
MONGO_URI=mongodb://127.0.0.1:27017/campusComplaints

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Optional: restrict CORS to your frontend (comma-separated). Leave empty to allow all.
CLIENT_URL=http://localhost:3000

# Only used by `npm run seed:admin`
ADMIN_EMAIL=admin@campus.com
ADMIN_PASSWORD=choose-a-strong-password
